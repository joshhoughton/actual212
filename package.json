    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@actual-app/api": "^26.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=26"
  }
}
